<launch>
  <let name="urdf_path" value="$(find-pkg-share mobile_robot_description)/urdf/mobile_robot.xacro" />

  <!-- Start robot_state_publisher node by passing urdf file -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
  </node>

  <!-- Start the node responsible for GUI window with silder -->
  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />

  <!-- Start the RViz 3D window -->
  <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(find-pkg-share mobile_robot_description)/config/rviz_config.rviz"/>
</launch>
