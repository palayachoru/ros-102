<?xml version="1.0" ?>

<robot name="MobileRobotCasterWheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Include another xacro file -->
  <xacro:include filename="materials.xacro" />


  <!-- Dimensions of Chassis & Wheel -->
  <xacro:property name="length" value="0.6" />
  <xacro:property name="width" value="0.4" />
  <xacro:property name="height" value="0.2" />

  <xacro:property name="w_radius" value="0.1" />
  <xacro:property name="w_length" value="0.05" />
  <xacro:property name="c_radius" value="0.05" />

  <!-- MAcro function to generate wheels -->
  <xacro:macro name="generate_wheel_link" params="wheel_name">
    <link name="${wheel_name}">
      <visual>
        <geometry>
          <cylinder radius="${w_radius}" length="${w_length}" />
        </geometry>

        <!-- pi is defined in xacro -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <material name="black" />
      </visual>
    </link>
  </xacro:macro>



  <!-- Base Link =========================================================== -->
  <link name="base_link"> </link>


  <!-- Chassis Link ======================================================== -->
  <link name="chassis">
    <visual>
      <geometry>
        <box size="${length} ${width} ${height}" />
      </geometry>

      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="green" />
    </visual>
  </link>


  <!-- Wheels Link ========================================================= -->
  <xacro:generate_wheel_link wheel_name="right_wheel" />
  <xacro:generate_wheel_link wheel_name="left_wheel" />


<!-- Castor Wheel Link ===================================================== -->
  <link name="castor_wheel">
    <visual>
      <geometry>
        <sphere radius="${c_radius}" />
      </geometry>

      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="gray" />
    </visual>
  </link>



  <!-- Base to Chassis Joint =============================================== -->
  <joint name="base_chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />

    <origin xyz="0 0 ${height/2}" rpy="0 0 0" />
  </joint>

  <!-- Wheels Joint ======================================================== -->
  <joint name="chassis_rwheel_joint" type="continuous">
    <parent link="chassis" />
    <child link="right_wheel" />

    <origin xyz="-${length/4} -${width/2} -${height/2}" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>


  <joint name="chassis_lwheel_joint" type="continuous">
    <parent link="chassis" />
    <child link="left_wheel" />

    <origin xyz="-${length/4} ${width/2} -${height/2}" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>


  <!-- Castor wheel Joint ================================================== -->
  <joint name="chassis_cwheel_joint" type="fixed">
    <parent link="chassis" />
    <child link="castor_wheel" />

    <origin xyz="${length/4} 0 -${height/2 + c_radius}" rpy="0 0 0" />
  </joint>

</robot>
